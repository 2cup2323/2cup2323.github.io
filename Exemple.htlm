            <li>11 h – 23 h</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <span id="year"></span> Café Lézard. Tous droits réservés.</span>
      <span>Fait avec soin à Montréal 🦎</span>
    </div>
  </div>
</footer>

<script>
(function(){
  "use strict";

  /* ---------- Horaires (0 = dimanche) ---------- */
  var HORAIRES = {
    0:[11,23], 1:[11,23], 2:[11,23], 3:[11,23],
    4:[11,23], 5:[11,23], 6:[11,23]
  };

  function heureTexte(h){
    return h + " h";
  }

  function majStatut(){
    var now = new Date();
    var jour = now.getDay();
    var plage = HORAIRES[jour];
    var h = now.getHours() + now.getMinutes()/60;
    var ouvert = h >= plage[0] && h < plage[1];

    var box = document.getElementById("status");
    var txt = document.getElementById("status-text");

    if (ouvert){
      box.classList.remove("closed");
      txt.textContent = "Ouvert maintenant · ferme à " + heureTexte(plage[1]);
    } else if (h < plage[0]){
      box.classList.add("closed");
      txt.textContent = "Fermé · ouvre aujourd'hui à " + heureTexte(plage[0]);
    } else {
      var demain = HORAIRES[(jour + 1) % 7];
      box.classList.add("closed");
      txt.textContent = "Fermé · ouvre demain à " + heureTexte(demain[0]);
    }

    // Ligne du jour dans le tableau
    var lignes = document.querySelectorAll("#hours-table li");
    lignes.forEach(function(li){
      li.classList.toggle("today", Number(li.dataset.day) === jour);
    });
  }
  majStatut();
  setInterval(majStatut, 60000);

  /* ---------- Header au défilement ---------- */
  var header = document.getElementById("header");
  function onScroll(){
    header.classList.toggle("scrolled", window.scrollY > 40);
  }
  onScroll();
  window.addEventListener("scroll", onScroll, {passive:true});

  /* ---------- Menu mobile ---------- */
  var burger = document.getElementById("burger");
  var nav = document.getElementById("nav");

  burger.addEventListener("click", function(){
    var ouvert = nav.classList.toggle("open");
    burger.setAttribute("aria-expanded", ouvert ? "true" : "false");
    burger.setAttribute("aria-label", ouvert ? "Fermer le menu de navigation" : "Ouvrir le menu de navigation");
  });

  nav.querySelectorAll("a").forEach(function(a){
    a.addEventListener("click", function(){
      nav.classList.remove("open");
      burger.setAttribute("aria-expanded","false");
    });
  });

  /* ---------- Onglets du menu ---------- */
  var tabs = Array.prototype.slice.call(document.querySelectorAll(".tab"));
  var panels = Array.prototype.slice.call(document.querySelectorAll(".menu-panel"));

  function activerTab(tab){
    tabs.forEach(function(t){
      var actif = t === tab;
      t.setAttribute("aria-selected", actif ? "true" : "false");
    });
    panels.forEach(function(p){
      var actif = p.id === tab.getAttribute("aria-controls");
      p.classList.toggle("active", actif);
      if (actif) { p.removeAttribute("hidden"); } else { p.setAttribute("hidden",""); }
    });
  }

  tabs.forEach(function(tab, i){
    tab.addEventListener("click", function(){ activerTab(tab); });
    tab.addEventListener("keydown", function(e){
      var cible = null;
      if (e.key === "ArrowRight") cible = tabs[(i + 1) % tabs.length];
      if (e.key === "ArrowLeft")  cible = tabs[(i - 1 + tabs.length) % tabs.length];
      if (cible){ e.preventDefault(); cible.focus(); activerTab(cible); }
    });
  });

  /* ---------- Apparition au défilement ---------- */
  var reveals = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          entry.target.classList.add("in");
          io.unobserve(entry.target);
        }
      });
    }, {threshold:.12, rootMargin:"0px 0px -60px 0px"});
    reveals.forEach(function(el){ io.observe(el); });
  } else {
    reveals.forEach(function(el){ el.classList.add("in"); });
  }

  /* ---------- Formulaire infolettre ---------- */
  var form = document.getElementById("follow-form");
  var msg = document.getElementById("form-msg");

  form.addEventListener("submit", function(e){
    e.preventDefault();
    var email = document.getElementById("email").value.trim();
    var valide = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    msg.classList.add("show");
    if (valide){
      msg.style.color = "#E7C27E";
      msg.textContent = "Merci ! On vous écrira bientôt. 🦎";
      form.reset();
    } else {
      msg.style.color = "#F0A98C";
      msg.textContent = "Oups — vérifiez votre adresse courriel.";
    }
  });

  /* ---------- Année ---------- */
  document.getElementById("year").textContent = new Date().getFullYear();

})();
</script>
</body>
</html>
