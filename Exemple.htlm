<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="brand-text">Café <em>Lézard</em></span>
        <p>Café de quartier à Rosemont. Espresso de spécialité, bouchées maison et vins nature, tous les jours de 11 h à 23 h.</p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h4>Naviguer</h4>
          <ul>
            <li><a href="#bonjour">Bonjour</a></li>
            <li><a href="#apropos">Qui sommes-nous ?</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#vins">Carte des vins</a></li>
          </ul>
        </div>
